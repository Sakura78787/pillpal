VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional server-side aliases; Functions fall back to the VITE_ values above.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

VITE_AI_WEEKLY_REPORT_ENABLED=false
AI_WEEKLY_REPORT_ENABLED=false
AI_WEEKLY_REPORT_EVAL_MODE=false
# Legacy synchronous compatibility endpoint only; async jobs always use V2.
AI_WEEKLY_REPORT_PROMPT_VERSION=v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_MAX_OUTPUT_TOKENS=1400
QWEN_REQUEST_TIMEOUT_MS=45000
QWEN_BACKGROUND_REQUEST_TIMEOUT_MS=90000
DASHSCOPE_API_KEY=
SUPABASE_SECRET_KEY=

# Formal evaluation runner only. Use a short-lived access token and never commit it.
PILLPAL_EVAL_ENDPOINT=
PILLPAL_EVAL_ACCESS_TOKEN=
